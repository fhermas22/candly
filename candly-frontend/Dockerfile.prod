# ─────────────────────────────────────────────────────────
# Dockerfile for Candly Frontend - Multi-stage build
# ─────────────────────────────────────────────────────────

# ===== Stage 1 : Build =====
# Step 1 : Base Image
FROM node:20-alpine AS builder
# Step 2 : Set the working directory
WORKDIR /app
# Step 3 : Copy the dependency files FIRST (cache optimization)
COPY package*.json ./
# Step 4 : Install the Node.js dependencies
RUN npm ci
# Step 5 : Copy the rest of the source code
COPY . .
# Step 6 : Set the VITE_API_BASE_URL environment variable for the build
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
# Step 7 : Build the React application for production
RUN npm run build

# ===== Stage 2 : Serve =====
# Step 1 : Base Image
FROM nginx:alpine AS production
# Step 2 : Copy the built React application from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html
# Step 3 : Copy the custom Nginx configuration file
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Step 4 : Expose the port for Nginx
EXPOSE 80
# Step 5 : Start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]
# ─────────────────────────────────────────────────────────
# Production Dockerfile for Candly API
# ─────────────────────────────────────────────────────────

# Step 1 : Base Image
FROM php:8.4-fpm-alpine AS production

# Step 2 : Install system dependencies and PHP extensions
RUN apk add --no-cache \
    bash curl libpng-dev libzip-dev \
    zip unzip nginx supervisor

# Step 3 : Install PHP extensions
RUN docker-php-ext-install \
    pdo pdo_mysql zip gd opcache

# Step 4 : Configure PHP settings for production (opcache optimization)
RUN { \
    echo "opcache.enable=1"; \
    echo "opcache.memory_consumption=128"; \
    echo "opcache.max_accelerated_files=10000"; \
    echo "opcache.validate_timestamps=0"; \
    echo "opcache.revalidate_freq=0"; \
    } > /usr/local/etc/php/conf.d/opcache.ini

# Step 5 : Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html

# Step 6 : Copy dependencies (Docker cache)
COPY composer.json composer.lock ./

# Step 7 : Install PHP dependencies using Composer
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --no-progress \
    --no-scripts

# Step 8 : Copy the application source code
COPY . .

# Step 9 : Generate the Laravel application cache configurations
RUN php artisan config:cache && \
    php artisan route:cache && \
    php artisan view:cache

# Step 10 : Set permissions for storage and bootstrap/cache directories
RUN chown -R www-data:www-data \
    /var/www/html/storage \
    /var/www/html/bootstrap/cache && \
    chmod -R 775 \
    /var/www/html/storage \
    /var/www/html/bootstrap/cache

# Step 11 : Configure Nginx
EXPOSE 8000

# Step 12 : Start command
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
